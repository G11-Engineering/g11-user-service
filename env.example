# Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3001
SERVER_HOST=localhost
BASE_URL=http://localhost:3001

# ============================================
# Frontend/CORS Configuration
# ============================================
FRONTEND_URL=http://localhost:3000
# For multiple origins, use comma-separated values:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://example.com

# ============================================
# Database Configuration
# ============================================
# Full connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user_service:user_password@localhost:5433/user_service

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Security Configuration
# ============================================
BCRYPT_ROUNDS=12
SESSION_EXPIRATION_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# Asgardeo Configuration
# ============================================
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/g11engineering
ASGARDEO_CLIENT_ID=Y4Yrhdn2PcIxQRLfWYDdEycYTfUa
ASGARDEO_M2M_CLIENT_ID=
ASGARDEO_M2M_CLIENT_SECRET=
ASGARDEO_ORG_NAME=

# ============================================
# API Paths Configuration
# ============================================
HEALTH_CHECK_PATH=/health
API_PREFIX=/api
AUTH_PREFIX=/api/auth
USERS_PREFIX=/api/users

# ============================================
# Pagination Configuration
# ============================================
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# ============================================
# Default Admin User Configuration
# ============================================
# These are used when creating the default admin user during database initialization
DEFAULT_ADMIN_EMAIL=admin@cms.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

# ============================================
# Database Schema Path
# ============================================
# Path to the database schema SQL file (optional, uses default if not set)
# DATABASE_SCHEMA_PATH=/path/to/your/schema.sql
